# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection. The app creates all tables at startup; no manual SQL
# import or sample records are required. URL-encode special password characters.
DATABASE_URL=postgresql://royal_knot_app:CHANGE_ME@127.0.0.1:5432/royal_knot

# Signs every sign-in token. Use a long random value in production, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Keep production data dynamic. Set to 1 only when you intentionally want the
# local demo dataset.
SEED_ON_START="0"

# Required only for the first clean deployment. This account becomes the
# founder who can create the rest of the team; it is never replaced on restart.
BOOTSTRAP_FOUNDER_NAME="Royal Knot Admin"
BOOTSTRAP_FOUNDER_EMAIL="admin@example.com"
BOOTSTRAP_FOUNDER_PASSWORD="CHANGE_ME"

# Optional — the founder's and managers' assistant. Without a key it still
# answers from your records; with one, Claude writes the answers.
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-sonnet-5-5

# Optional SQL logging while diagnosing a connection.
# DATABASE_ECHO=0
